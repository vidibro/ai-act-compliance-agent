# Copy to .env and fill in. Never commit .env.
# All settings are consumed by src/aiact/config.py (pydantic-settings), prefix AIACT_.

# --- LLM provider (LiteLLM) ---
# LiteLLM routes by model string; supply whichever provider key matches AIACT_LLM_MODEL.
AIACT_LLM_MODEL=anthropic/claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- OR: route through a LiteLLM proxy instead of calling a vendor directly ---
#
#   AIACT_LLM_MODEL=litellm_proxy/gemini-2.5-flash
#   LITELLM_PROXY_URL=https://your-proxy.example.com
#   LITELLM_PROXY_API_KEY=
#
# The proxy prefix is transparent to the provider seam: aiact.providers looks THROUGH it and
# resolves the request shape from the real vendor behind it. Without that, a proxied model would
# fall back to the generic profile and silently lose its reasoning parameter.

# --- Reasoning depth: "high" | "medium" | "low" | "none" ---
# All three are "none" today because that is what MEASURED best on gemini-2.5-flash — the judge went
# 1/6 -> 5/6 on INADEQUATE detection and 66% -> 98% on false positives as effort went high -> none,
# with cost falling $1.04 -> $0.16, and the classifier scored 9/9 on both axes with zero
# abstentions. Both jobs ask bounded questions with enum answers; deliberation only gave the model
# room to talk itself out of a verdict.
#
# The per-job knobs are kept SET rather than left to inherit, because they stop being redundant the
# moment the model changes — a model whose strength is reasoning may well want the two jobs at
# different depths, and the place to discover that is here, not in the code.
AIACT_LLM_EFFORT=none
AIACT_CLASSIFY_EFFORT=none
AIACT_JUDGE_EFFORT=none

# --- EVAL ONLY: the reasoning-grounding grader (scripts/run_grounding.py) ---
# Which model checks whether a justification stayed inside the text it was reached from. Blank
# inherits AIACT_LLM_MODEL, which means THE SYSTEM MARKS ITS OWN WORK — shared blind spots, and a
# known tendency to rate one's own output well. Left blank by default so a run is cheap and needs
# no second key, and the scorecard prints a SELF-GRADED warning beside the number when it is.
#
# Point it at a different family to find out how flattering the self-graded number is. Grading is a
# much smaller job than answering — the calls are short — so a pricier grader over a cheap answerer
# is an affordable combination.
#
AIACT_GRADER_MODEL=
AIACT_GRADER_EFFORT=none

# --- Vector store (Chroma, local) ---
AIACT_CHROMA_PATH=./chroma

# --- Input limit ---
# 0 disables the check.
AIACT_MAX_DOCUMENT_CHARS=300000

# --- Observability (Langfuse) ---
# Set BOTH keys to turn tracing on; leave either blank and every run is an exact no-op (no import,
# no network). With keys set, `python scripts/classify.py --golden` files one trace per use case,
# its spans being the cascade nodes in order — the decision path. See src/aiact/tracing.py.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Policy / reproducibility ---
# Pinned snapshot date of the Regulation the loaded PolicySpec was derived from.
AIACT_ACT_VERSION_DATE=2026-07-27
AIACT_POLICY_SPEC_PATH=./data/policy/spec.yaml
