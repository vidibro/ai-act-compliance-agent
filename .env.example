# Copy to .env and fill in. Never commit .env.
# All settings are consumed by src/aiact/config.py (pydantic-settings), prefix AIACT_.

# --- LLM provider (LiteLLM) ---
# LiteLLM routes by model string; supply whichever provider key matches AIACT_LLM_MODEL.
AIACT_LLM_MODEL=anthropic/claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- OR: route through a LiteLLM proxy instead of calling a vendor directly ---
#
#   AIACT_LLM_MODEL=litellm_proxy/gemini-2.5-flash
#   LITELLM_PROXY_URL=https://your-proxy.example.com
#   LITELLM_PROXY_API_KEY=
#
# The proxy prefix is transparent to the provider seam: aiact.providers looks THROUGH it and
# resolves the request shape from the real vendor behind it. Without that, a proxied model would
# fall back to the generic profile and silently lose its reasoning parameter.

# --- Reasoning depth: "high" | "medium" | "low" | "none" ---
AIACT_LLM_EFFORT=none
AIACT_CLASSIFY_EFFORT=none
AIACT_JUDGE_EFFORT=none

# --- Vector store (Chroma, local) ---
AIACT_CHROMA_PATH=./chroma

# --- Observability (Langfuse) ---
# Set BOTH keys to turn tracing on; leave either blank and every run is an exact no-op (no import,
# no network). With keys set, `python scripts/classify.py --golden` files one trace per use case,
# its spans being the cascade nodes in order — the decision path. See src/aiact/tracing.py.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Policy / reproducibility ---
# Pinned snapshot date of the Regulation the loaded PolicySpec was derived from.
AIACT_ACT_VERSION_DATE=2024-07-12
AIACT_POLICY_SPEC_PATH=./data/policy/spec.yaml
